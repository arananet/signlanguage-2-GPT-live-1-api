{
  "name": "signflow-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --use-system-ca --env-file-if-exists=.env server/index.mjs",
    "start": "node --use-system-ca --env-file-if-exists=.env server/index.mjs --production",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "assets": "node --use-system-ca scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "dynamic-time-warping": "^1.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "yaml": "^2.9.1"
  }
}
